{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api"
    },
    {
      "src": "/docs",
      "dest": "/api/docs"
    },
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ]
}
